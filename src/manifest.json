{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "Zread Docs for GitHub",
  "description": "View Zread.ai documentation for any GitHub repository right on the repo page: sidebar TOC, in-page docs and diagrams.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "alarms",
    "cookies",
    "scripting",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.github.com/*",
    "*://zread.ai/*"
  ],
  "background": {
    "service_worker": "background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "content/index.tsx"
      ],
      "run_at": "document_idle"
    }
  ],
  "firefox:browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
