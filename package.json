{
  "private": true,
  "name": "zread-github-ext",
  "description": "View Zread.ai documentation for any GitHub repository right on the repo page. 在 GitHub 仓库页直接查看 zread.ai 文档。",
  "version": "0.1.9",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "extension dev",
    "start": "extension start",
    "build": "extension build && bun run build:mermaid",
    "build:mermaid": "esbuild src/lib/mermaid-renderer.ts --bundle --format=iife --minify --outfile=dist/chromium/mermaid_renderer.js",
    "build:mermaid:firefox": "esbuild src/lib/mermaid-renderer.ts --bundle --format=iife --minify --outfile=dist/firefox/mermaid_renderer.js",
    "build:mermaid:edge": "esbuild src/lib/mermaid-renderer.ts --bundle --format=iife --minify --outfile=dist/edge/mermaid_renderer.js",
    "preview": "extension preview",
    "build:chrome": "extension build --browser chrome && bun run build:mermaid",
    "build:firefox": "extension build --browser firefox && bun run build:mermaid:firefox",
    "build:edge": "extension build --browser edge && bun run build:mermaid:edge"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "extension": "^4.1.10",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejfkdev/zread-ext.git"
  },
  "homepage": "https://github.com/ejfkdev/zread-ext#readme",
  "bugs": {
    "url": "https://github.com/ejfkdev/zread-ext/issues"
  },
  "author": "ejfkdev"
}
